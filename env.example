import express from 'express';
import dotenv from 'dotenv';
import axios from 'axios';
import cors from 'cors';
import helmet from 'helmet';

dotenv.config();

const app = express();
const PORT = process.env.PORT || 3000;

// Middleware
app.use(helmet());
const allowedOrigins = [
  process.env.FRONTEND_URL,
  'https://asfregisterlaunchcup2026.webthey.com',
  'http://localhost:5173'
].filter(Boolean);

app.use(cors({
  origin: (origin, callback) => {
    // Allow requests with no origin (like mobile apps or curl requests)
    if (!origin) return callback(null, true);
    if (allowedOrigins.indexOf(origin) !== -1 || allowedOrigins.includes('*')) {
      callback(null, true);
    } else {
      callback(new Error('Not allowed by CORS'));
    }
  },
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  credentials: true
}));
app.use(express.json());

// Cashfree Payment API
app.post('/api/payment/create', async (req, res) => {
  const { amount, squadName, email, mobile, customer_id } = req.body;

  const appId = (process.env.CASHFREE_APP_ID || '').trim();
  const secretKey = (process.env.CASHFREE_SECRET_KEY || '').trim();

  if (!appId || !secretKey) {
    return res.status(500).json({ error: 'Payment gateway configuration missing' });
  }

  try {
    const orderId = `ASF_${Date.now()}`;
    const mode = (process.env.VITE_CASHFREE_MODE || 'sandbox').toLowerCase().trim();
    const isProduction = mode === 'production' || mode === 'live';
    const baseUrl = isProduction ? 'https://api.cashfree.com/pg' : 'https://sandbox.cashfree.com/pg';
    
    // Frontend URL for return
    const frontendUrl = process.env.FRONTEND_URL || 'http://localhost:5173';
    
    const response = await axios.post(`${baseUrl}/orders`, {
      order_id: orderId,
      order_amount: Number(amount).toFixed(2),
      order_currency: 'INR',
      customer_details: {
        customer_id: customer_id || `cust_${Date.now()}`,
        customer_email: (email || 'user@example.com').toLowerCase().trim(),
        customer_phone: mobile.toString().replace(/\D/g, '').slice(-10),
      },
      order_meta: {
        return_url: `${process.env.API_BASE_URL || ''}/api/payment/verify?order_id={order_id}&frontend_url=${encodeURIComponent(frontendUrl)}`,
      },
      order_note: `Registration for ${squadName || 'ASF Tournament'}`,
    }, {
      headers: {
        'x-client-id': appId,
        'x-client-secret': secretKey,
        'x-api-version': '2023-08-01',
        'Content-Type': 'application/json'
      }
    });

    res.json({ 
      payment_session_id: response.data.payment_session_id,
      order_id: response.data.order_id
    });
  } catch (error: any) {
    res.status(error.response?.status || 500).json(error.response?.data || error.message);
  }
});

app.get('/api/payment/verify', async (req, res) => {
  const { order_id, frontend_url } = req.query;
  const appId = (process.env.CASHFREE_APP_ID || '').trim();
  const secretKey = (process.env.CASHFREE_SECRET_KEY || '').trim();

  try {
    const mode = (process.env.VITE_CASHFREE_MODE || 'sandbox').toLowerCase().trim();
    const isProduction = mode === 'production' || mode === 'live';
    const baseUrl = isProduction ? 'https://api.cashfree.com/pg' : 'https://sandbox.cashfree.com/pg';

    const response = await axios.get(`${baseUrl}/orders/${order_id}`, {
      headers: {
        'x-client-id': appId,
        'x-client-secret': secretKey,
        'x-api-version': '2023-08-01',
      }
    });

    const status = response.data.order_status;
    const redirectUrl = frontend_url ? `${frontend_url}/?payment_status=${status}&order_id=${order_id}` : `/?payment_status=${status}&order_id=${order_id}`;
    res.redirect(redirectUrl);
  } catch (error: any) {
    res.redirect(`${frontend_url || ''}/?payment_status=ERROR`);
  }
});

// Brevo OTP API
app.post('/api/send-otp', async (req, res) => {
  const { to, subject, htmlContent, sender } = req.body;
  const apiKey = process.env.BREVO_API_KEY;

  if (!apiKey) return res.status(500).json({ error: 'BREVO_API_KEY missing' });

  try {
    const response = await axios.post('https://api.brevo.com/v3/smtp/email', {
      sender: sender || { 
        name: process.env.SENDER_NAME || 'Arena Supremacy Federation', 
        email: process.env.SENDER_EMAIL || 'asfesports2026@gmail.com' 
      },
      to,
      subject: subject || '[ASF] Verification Code',
      htmlContent
    }, {
      headers: { 'api-key': apiKey, 'Content-Type': 'application/json' }
    });
    res.json(response.data);
  } catch (error: any) {
    res.status(500).json(error.response?.data || error.message);
  }
});

